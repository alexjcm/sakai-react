{
  "name": "sakai-react",
  "version": "10.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "security:check": "npm audit --omit=dev --audit-level critical",
    "format": "prettier --write \"{app,demo,layout,types}/**/*.{js,ts,tsx,d.ts}\"",
    "format:check": "prettier --check \"{app,demo,layout,types}/**/*.{js,ts,tsx,d.ts}\"",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix"
  },
  "dependencies": {
    "next": "^15.3.2",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "10.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.4.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@types/node": "22.15.21",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "9.27.0",
    "eslint-config-next": "15.1.8",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "sass": "^1.89.0"
  },
  "engines": {
      "node": ">=20"
  }
}
